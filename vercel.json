{
  "installCommand": "npm ci --prefix web && npm ci --prefix pwa-asistente && npm ci --prefix pwa-familia",
  "buildCommand": "node scripts/armar_todo.mjs",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:pagina.html",
      "destination": "/:pagina",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!pwa-asistente|pwa-familia|assets|data|docs).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/pwa-asistente/service-worker.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/pwa-asistente/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/pwa-familia/service-worker.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/pwa-familia/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
